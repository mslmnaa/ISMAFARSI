# Copy this file to .env and fill in real values (do NOT commit .env)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ismafarsi_db"
PORT=5000
JWT_SECRET="ganti-dengan-string-acak-panjang-dan-rahasia"

# Only set this if deploying under a subpath, e.g. http://IP_VPS/ismafarsi
# Leave empty when serving at root (http://IP_VPS or a domain).
PUBLIC_BASE_PATH=
