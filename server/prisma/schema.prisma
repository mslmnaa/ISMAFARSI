generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  date      DateTime
  author    String
  image     String   @db.Text
  excerpt   String   @db.Text
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  date        DateTime
  location    String
  description String   @db.Text
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CabinetMember {
  id          Int      @id @default(autoincrement())
  name        String
  position    String
  institution String
  photo       String   @db.Text
  description String   @db.Text
  cabinetName String   @default("Pranavritta 2024-2026")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Program {
  id          Int      @id @default(autoincrement())
  department  String
  name        String
  goal        String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Region {
  id           Int      @id @default(autoincrement())
  name         String
  code         String
  description  String   @db.Text
  provinces    String   @db.Text // Store as JSON string or comma separated
  members      Int
  universities Int
  head         String
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text // Can store JSON strings for complex objects like the whole defaultContent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}